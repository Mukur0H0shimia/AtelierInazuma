<?xml version="1.0" encoding="utf-8"?>
<!-- Atelier Inazuma.exe : bibliothèques WebView2 (lanceur\webview2) chargées même si le dossier vient d'un zip téléchargé.
     Lets the launcher load the WebView2 libraries even when the folder comes from a downloaded zip. -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
